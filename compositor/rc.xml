<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  VDE (Victorious Desktop Environment) - Labwc Compositor Configuration
  Designed for Fluent Ergonomics, Snapping, and Sub-500MB Idle RAM
-->
<labwc_config>
  <core>
    <!-- Gaps and margins -->
    <gap>6</gap>
    <adaptiveSync>true</adaptiveSync>
    <reuseOutputMode>true</reuseOutputMode>
  </core>

  <!-- Window Snapping & Placement -->
  <snapping>
    <range inner="10" outer="10" />
    <topEdgeAction>Maximize</topEdgeAction>
    <leftEdgeAction>SnapLeft</leftEdgeAction>
    <rightEdgeAction>SnapRight</rightEdgeAction>
  </snapping>

  <!-- Theme & Window Decorations -->
  <theme>
    <name>VDE-Dark</name>
    <cornerRadius>8</cornerRadius>
    <titleHeight>32</titleHeight>
    <dropShadows>true</dropShadows>
    <font place="ActiveWindow">
      <name>Segoe UI Variable, Inter, Cantarell</name>
      <size>10</size>
      <weight>Medium</weight>
    </font>
    <font place="InactiveWindow">
      <name>Segoe UI Variable, Inter, Cantarell</name>
      <size>10</size>
      <weight>Normal</weight>
    </font>
  </theme>

  <windowRules>
    <!-- Prevent layer-shell and VDE popups from displaying titlebars -->
    <windowRule identifier="vde-bar" serverDecoration="no" />
    <windowRule identifier="vde-launcher" serverDecoration="no" />
    <windowRule identifier="vde-quicksettings" serverDecoration="no" />
  </windowRules>

  <!-- Keyboard Keybindings -->
  <keyboard>
    <default />

    <!-- ============================================== -->
    <!-- Fluent Snap & Window Ergonomics                -->
    <!-- ============================================== -->
    <!-- Super + Left: Snap Left Half -->
    <keybind key="W-Left">
      <action name="SnapToEdge"><direction>left</direction></action>
    </keybind>

    <!-- Super + Right: Snap Right Half -->
    <keybind key="W-Right">
      <action name="SnapToEdge"><direction>right</direction></action>
    </keybind>

    <!-- Super + Up: Maximize Window -->
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>

    <!-- Super + Down: Restore or Minimize Window -->
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>

    <!-- Super + Alt + Arrows: 4-Corner Quadrant Snapping -->
    <keybind key="W-A-Left">
      <action name="SnapToRegion"><region>0% 0% 50% 50%</region></action>
    </keybind>
    <keybind key="W-A-Right">
      <action name="SnapToRegion"><region>50% 0% 50% 50%</region></action>
    </keybind>
    <keybind key="W-A-Down">
      <action name="SnapToRegion"><region>0% 50% 50% 50%</region></action>
    </keybind>
    <keybind key="W-A-Up">
      <action name="SnapToRegion"><region>50% 50% 50% 50%</region></action>
    </keybind>

    <!-- Alt + F4: Close Window -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>

    <!-- Alt + Tab: Interactive task switcher -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- ============================================== -->
    <!-- VDE Shell Integration (D-Bus Signals)          -->
    <!-- ============================================== -->
    <!-- Super / Super + Space: Toggle Start Menu Launcher -->
    <keybind key="W-space">
      <action name="Execute">
        <command>qdbus org.vde.Launcher /Launcher org.vde.Launcher.Toggle</command>
      </action>
    </keybind>
    <keybind key="Super_L">
      <action name="Execute">
        <command>qdbus org.vde.Launcher /Launcher org.vde.Launcher.Toggle</command>
      </action>
    </keybind>

    <!-- Super + A: Toggle Quick Settings Flyout -->
    <keybind key="W-a">
      <action name="Execute">
        <command>qdbus org.vde.Shell /Shell org.vde.Shell.ToggleQuickSettings</command>
      </action>
    </keybind>

    <!-- Super + N: Toggle Notifications / Calendar -->
    <keybind key="W-n">
      <action name="Execute">
        <command>qdbus org.vde.Shell /Shell org.vde.Shell.ToggleCalendar</command>
      </action>
    </keybind>

    <!-- Super + E: File Explorer -->
    <keybind key="W-e">
      <action name="Execute">
        <command>xdg-open ~</command>
      </action>
    </keybind>

    <!-- Super + Return: Terminal -->
    <keybind key="W-Return">
      <action name="Execute">
        <command>foot || alacritty || x-terminal-emulator</command>
      </action>
    </keybind>

    <!-- Super + L: Lock Screen -->
    <keybind key="W-l">
      <action name="Execute">
        <command>swaylock -c 202020 || loginctl lock-session</command>
      </action>
    </keybind>

    <!-- PrintScreen: Screenshot -->
    <keybind key="Print">
      <action name="Execute">
        <command>grim -g "$(slurp)" - | wl-copy</command>
      </action>
    </keybind>
  </keyboard>

  <!-- Mouse Bindings -->
  <mouse>
    <default />
    <!-- Window dragging with Super + Left Click -->
    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>
</labwc_config>
