<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  VDE (Victorious Desktop Environment) - Labwc Compositor Configuration
  Designed for Fluent Ergonomics, Snapping, and Sub-500MB Idle RAM
-->
<labwc_config>
  <core>
    <!-- Gaps and margins -->
    <gap>6</gap>
    <adaptiveSync>true</adaptiveSync>
    <reuseOutputMode>true</reuseOutputMode>
  </core>

  <!-- Window Snapping & Placement -->
  <snapping>
    <range inner="10" outer="10" />
    <topEdgeAction>Maximize</topEdgeAction>
    <leftEdgeAction>SnapLeft</leftEdgeAction>
    <rightEdgeAction>SnapRight</rightEdgeAction>
  </snapping>

  <!-- Theme & Window Decorations -->
  <theme>
    <name>VDE-Dark</name>
    <cornerRadius>10</cornerRadius>
    <titleHeight>34</titleHeight>
    <titleLayout>NLIMC</titleLayout>
    <dropShadows>true</dropShadows>
    <font place="ActiveWindow">
      <name>Segoe UI Variable, Inter, Cantarell</name>
      <size>10</size>
      <weight>Medium</weight>
    </font>
    <font place="InactiveWindow">
      <name>Segoe UI Variable, Inter, Cantarell</name>
      <size>10</size>
      <weight>Normal</weight>
    </font>
  </theme>

  <windowRules>
    <!-- Prevent layer-shell and VDE popups from displaying titlebars -->
    <windowRule identifier="vde-bar" serverDecoration="no" />
    <windowRule identifier="vde-launcher" serverDecoration="no" />
    <windowRule identifier="vde-quicksettings" serverDecoration="no" />
    <windowRule identifier="waybar" serverDecoration="no" />
  </windowRules>

  <!-- Keyboard Keybindings -->
  <keyboard>
    <default />

    <!-- ============================================== -->
    <!-- Fluent Snap & Window Ergonomics                -->
    <!-- ============================================== -->
    <!-- Super + Left: Snap Left Half -->
    <keybind key="W-Left">
      <action name="SnapToEdge"><direction>left</direction></action>
    </keybind>

    <!-- Super + Right: Snap Right Half -->
    <keybind key="W-Right">
      <action name="SnapToEdge"><direction>right</direction></action>
    </keybind>

    <!-- Super + Up: Maximize Window -->
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>

    <!-- Super + Down: Restore or Minimize Window -->
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>

    <!-- Super + Alt + Arrows: 4-Corner Quadrant Snapping -->
    <keybind key="W-A-Left">
      <action name="SnapToRegion"><region>0% 0% 50% 50%</region></action>
    </keybind>
    <keybind key="W-A-Right">
      <action name="SnapToRegion"><region>50% 0% 50% 50%</region></action>
    </keybind>
    <keybind key="W-A-Down">
      <action name="SnapToRegion"><region>0% 50% 50% 50%</region></action>
    </keybind>
    <keybind key="W-A-Up">
      <action name="SnapToRegion"><region>50% 50% 50% 50%</region></action>
    </keybind>

    <!-- Alt + F4 / Super + Q: Close Window -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <!-- Alt + Tab: Interactive task switcher -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- ============================================== -->
    <!-- VDE Shell Integration (Start & Apps)           -->
    <!-- ============================================== -->
    <!-- Super / Super + Space / Super_L / Super_R: Toggle Start Menu Launcher -->
    <keybind key="W-space">
      <action name="Execute">
        <command>/usr/local/bin/vde-launcher</command>
      </action>
    </keybind>
    <keybind key="Super_L">
      <action name="Execute">
        <command>/usr/local/bin/vde-launcher</command>
      </action>
    </keybind>
    <keybind key="Super_R">
      <action name="Execute">
        <command>/usr/local/bin/vde-launcher</command>
      </action>
    </keybind>
    <keybind key="W-r">
      <action name="Execute">
        <command>/usr/local/bin/vde-launcher</command>
      </action>
    </keybind>
    <keybind key="W-a">
      <action name="Execute">
        <command>/usr/local/bin/vde-quicksettings</command>
      </action>
    </keybind>
    <keybind key="W-n">
      <action name="Execute">
        <command>/usr/local/bin/vde-quicksettings</command>
      </action>
    </keybind>

    <!-- Terminal: Crossminal (Super+Return, Super+T, Ctrl+Alt+T) -->
    <keybind key="W-Return">
      <action name="Execute">
        <command>/usr/local/bin/crossminal</command>
      </action>
    </keybind>
    <keybind key="W-t">
      <action name="Execute">
        <command>/usr/local/bin/crossminal</command>
      </action>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute">
        <command>/usr/local/bin/crossminal</command>
      </action>
    </keybind>

    <!-- Settings: Crossings (Super+I, Super+S) -->
    <keybind key="W-i">
      <action name="Execute">
        <command>/usr/local/bin/crossings</command>
      </action>
    </keybind>
    <keybind key="W-s">
      <action name="Execute">
        <command>/usr/local/bin/crossings</command>
      </action>
    </keybind>

    <!-- File Explorer: Crossmanager (Super+E) -->
    <keybind key="W-e">
      <action name="Execute">
        <command>/usr/local/bin/crossmanager</command>
      </action>
    </keybind>

    <!-- Display Toggle / Project / Mirror: Super+P, XF86Display -->
    <keybind key="W-p">
      <action name="Execute">
        <command>/usr/local/bin/vde-display-toggle</command>
      </action>
    </keybind>
    <keybind key="XF86Display">
      <action name="Execute">
        <command>/usr/local/bin/vde-display-toggle</command>
      </action>
    </keybind>

    <!-- Snipping Tool: PrintScreen, Super+Shift+S -->
    <keybind key="Print">
      <action name="Execute">
        <command>/usr/local/bin/crossnip</command>
      </action>
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute">
        <command>/usr/local/bin/crossnip</command>
      </action>
    </keybind>

    <!-- Audio Controls -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>sh -c "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ || pactl set-sink-volume @DEFAULT_SINK@ +5%"</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>sh -c "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- || pactl set-sink-volume @DEFAULT_SINK@ -5%"</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>sh -c "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle"</command>
      </action>
    </keybind>

    <!-- Brightness Controls -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>brightnessctl set +10%</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>brightnessctl set 10%-</command>
      </action>
    </keybind>

    <!-- Super + L: Lock Screen -->
    <keybind key="W-l">
      <action name="Execute">
        <command>swaylock -c 18181b || loginctl lock-session</command>
      </action>
    </keybind>
  </keyboard>

  <!-- Mouse Bindings -->
  <mouse>
    <default />
    <!-- Desktop Root Menu Bindings -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Execute" command="/usr/local/bin/crossminal" />
      </mousebind>
    </context>
    <!-- Window dragging with Super + Left Click -->
    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>
</labwc_config>
