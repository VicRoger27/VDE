# VDE Dark Theme for Labwc (Dark Mica & Acrylic Styling)
# ----------------------------------------------------

# Titlebar
window.active.title.bg.color: #202020
window.inactive.title.bg.color: #1a1a1a

# Titlebar Text
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #888888
window.label.text.justify: left

# Borders
border.width: 1
window.active.border.color: #383838
window.inactive.border.color: #282828

# Corner rounding & metrics
cornerRadius: 8
titleHeight: 32

# Window Control Buttons (Right aligned: Minimize, Maximize, Close)
# Openbox/Labwc format: [N] icon, [L] title, [I] iconify, [M] maximize, [C] close
window.button.width: 36
window.button.hover.bg.color: #2d2d2d
window.button.close.hover.bg.color: #c42b1c
window.button.pressed.bg.color: #252525

# Drop shadows
dropShadows: true
shadow.offset.x: 0
shadow.offset.y: 4
shadow.blur.radius: 12
shadow.color: #00000066
