# VDE Dark Theme for Labwc (Fluent Dark Mica & Windhawk Styling)
# ----------------------------------------------------

# Titlebar (Mica Translucent Finish)
window.active.title.bg.color: #1c1c20
window.inactive.title.bg.color: #141416

# Titlebar Text
window.active.label.text.color: #fafafa
window.inactive.label.text.color: #71717a
window.label.text.justify: left

# Borders (Subtle Glass Highlight)
border.width: 1
window.active.border.color: #3f3f46
window.inactive.border.color: #27272a

# Corner rounding & metrics (Windows 11 geometry)
cornerRadius: 10
titleHeight: 34

# Window Control Buttons (Right aligned: Minimize, Maximize, Close)
# Openbox/Labwc format: [N] icon, [L] title, [I] iconify, [M] maximize, [C] close
window.button.width: 44
window.button.hover.bg.color: #2d2d34
window.button.close.hover.bg.color: #c42b1c
window.button.pressed.bg.color: #252528

# Drop shadows (Soft Ambient Mica Shadow)
dropShadows: true
shadow.offset.x: 0
shadow.offset.y: 6
shadow.blur.radius: 16
shadow.color: #00000088
