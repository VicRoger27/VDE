#!/usr/bin/env bash
# VDE Direct Command Entrypoint
# Initializes standalone VDE session on direct DRM/KMS hardware

# Unset remote display variables to prevent nested-window execution
unset WAYLAND_DISPLAY
unset DISPLAY

# Ensure DRM KMS is released from any background remnants
pkill -9 -f gnome-shell 2>/dev/null || true
pkill -9 -f mutter 2>/dev/null || true
pkill -9 -f Xwayland 2>/dev/null || true
sleep 1

# Launch clean standalone session
exec /usr/local/bin/vde-session "$@"
