#!/bin/sh
# VDE (Victorious Desktop Environment) Autostart Script
# Executed by Labwc compositor on startup

VDE_DIR="$(dirname "$0")"

# 1. Source Environment
if [ -f "$VDE_DIR/environment" ]; then
    . "$VDE_DIR/environment"
fi

# 2. Update D-Bus & systemd activation environment
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
fi

# 3. Import environment into systemd if available
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
    systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP 2>/dev/null || true
fi

# 4. Wallpaper Canvas Background
WALLPAPER_COLOR="#18181b"
if [ -f "$HOME/.config/vde/wallpaper.color" ]; then
    WALLPAPER_COLOR=$(cat "$HOME/.config/vde/wallpaper.color" 2>/dev/null || echo "#18181b")
fi
if command -v swaybg >/dev/null 2>&1; then
    pkill -9 -x swaybg 2>/dev/null || true
    if [ -f "$HOME/.config/vde/wallpaper.png" ]; then
        swaybg -i "$HOME/.config/vde/wallpaper.png" -m fill &
    elif [ -f "/usr/share/vde/assets/wallpapers/default.png" ]; then
        swaybg -i "/usr/share/vde/assets/wallpapers/default.png" -m fill &
    elif [ -f "/usr/share/vde/assets/wallpapers/vde_dark.png" ]; then
        swaybg -i "/usr/share/vde/assets/wallpapers/vde_dark.png" -m fill &
    else
        swaybg -c "$WALLPAPER_COLOR" &
    fi
fi

# 5. Audio Infrastructure (PipeWire & WirePlumber)
pgrep -x pipewire >/dev/null 2>&1 || (command -v pipewire >/dev/null 2>&1 && pipewire &)
pgrep -x wireplumber >/dev/null 2>&1 || (command -v wireplumber >/dev/null 2>&1 && wireplumber &)

# Wait 1.2s for compositor Wayland socket & layer-shell protocol to settle
sleep 1.2

# 6. Taskbar Shell (Waybar with Windhawk Acrylic styling)
if ! pgrep -x waybar >/dev/null 2>&1; then
    if [ -x "/usr/local/bin/vde-bar" ]; then
        /usr/local/bin/vde-bar &
    elif [ -x "$VDE_DIR/../astal-shell/vde-bar" ]; then
        "$VDE_DIR/../astal-shell/vde-bar" &
    elif command -v waybar >/dev/null 2>&1; then
        waybar -c /usr/share/vde/astal-shell/waybar_config.jsonc -s /usr/share/vde/astal-shell/waybar_style.css &
    fi
fi
