#!/bin/sh
# VDE (Victorious Desktop Environment) Autostart Script
# Executed by Labwc compositor on startup

VDE_DIR="$(dirname "$0")"

# 1. Source Environment
if [ -f "$VDE_DIR/environment" ]; then
    . "$VDE_DIR/environment"
fi

# 2. Update D-Bus & systemd activation environment
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
fi

# 3. Import environment into systemd if available
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
    systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP 2>/dev/null || true
fi

# 4. Core Session Processes
# Wallpaper / Canvas Background
command -v swaybg >/dev/null 2>&1 && swaybg -c '#18181b' &

# Audio Infrastructure
pgrep -x pipewire >/dev/null 2>&1 || (command -v pipewire >/dev/null 2>&1 && pipewire &)
pgrep -x wireplumber >/dev/null 2>&1 || (command -v wireplumber >/dev/null 2>&1 && wireplumber &)

# Taskbar & Shell Runner (Astal / Waybar fallback)
if ! pgrep -x waybar >/dev/null 2>&1; then
    if [ -x "/usr/local/bin/vde-bar" ]; then
        /usr/local/bin/vde-bar &
    elif [ -x "$VDE_DIR/../astal-shell/vde-bar" ]; then
        "$VDE_DIR/../astal-shell/vde-bar" &
    fi
fi

# Qt6 / QML Start Menu Daemon
if command -v vde-launcher >/dev/null 2>&1; then
    vde-launcher --daemon &
fi
