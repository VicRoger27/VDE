#!/usr/bin/env bash
# VDE Standalone Session Initializer
# Unsets remote display handles, initializes seat, launches Labwc on direct DRM/KMS hardware

# 1. Unset any remote displays to force direct DRM hardware initialization
unset WAYLAND_DISPLAY
unset DISPLAY

# 2. Desktop Environment Variables
export XDG_CURRENT_DESKTOP=VDE
export XDG_SESSION_DESKTOP=VDE
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1

# 3. Universal Rendering Options across hardware & VMs
export WLR_RENDERER=${WLR_RENDERER:-gles2}
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1

# 4. Ensure XDG_RUNTIME_DIR is accessible with 0700 permissions
if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    if [ ! -d "$XDG_RUNTIME_DIR" ]; then
        mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
        chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
    fi
fi

# 5. User D-Bus Session
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    if command -v dbus-launch >/dev/null 2>&1; then
        eval $(dbus-launch --sh-syntax --exit-with-session 2>/dev/null || true)
    fi
fi

# 6. Release DRM KMS connector from zombie display servers
pkill -9 -f gnome-shell 2>/dev/null || true
pkill -9 -f mutter 2>/dev/null || true
pkill -9 -f Xwayland 2>/dev/null || true
sleep 1

echo "=========================================================="
echo " Starting Victorious Desktop Environment (VDE)..."
echo " Compositor: Labwc (wlroots layer-shell)"
echo " Shell: Waybar Dark Mica & Wofi"
echo " Settings: Crossings Hub"
echo " Applications: VDE Fluent Suite"
echo "=========================================================="

# 7. Launch Labwc Compositor
labwc "$@"
EXIT_CODE=$?

# If GLES2 hardware rendering exited with error, fallback to Pixman software renderer
if [ $EXIT_CODE -ne 0 ]; then
    echo ">> [VDE] GLES2 renderer exited with code $EXIT_CODE. Retrying with Pixman software renderer..."
    export WLR_RENDERER=pixman
    exec labwc "$@"
fi
