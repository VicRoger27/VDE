#!/usr/bin/env bash
SCRIPT_DIR="$(dirname "$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")")"
if [ -f "$SCRIPT_DIR/crossaint.py" ]; then
    exec python3 "$SCRIPT_DIR/crossaint.py" "$@"
elif [ -f "/usr/share/vde/apps/crossaint/crossaint.py" ]; then
    exec python3 "/usr/share/vde/apps/crossaint/crossaint.py" "$@"
fi
exec drawing "$@" || exec pinta "$@"
