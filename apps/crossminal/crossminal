#!/usr/bin/env bash
SCRIPT_DIR="$(dirname "$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")")"
if [ -f "$SCRIPT_DIR/crossminal.py" ] && python3 -c "import gi; gi.require_version('Vte', '2.91')" 2>/dev/null; then
    exec python3 "$SCRIPT_DIR/crossminal.py" "$@"
fi
exec /usr/local/bin/vde-terminal "$@"
