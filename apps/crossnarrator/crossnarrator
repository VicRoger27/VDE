#!/usr/bin/env bash
SCRIPT_DIR="$(dirname "$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")")"
if [ -f "$SCRIPT_DIR/crossnarrator.py" ]; then
    exec python3 "$SCRIPT_DIR/crossnarrator.py" "$@"
elif [ -f "/usr/share/vde/apps/crossnarrator/crossnarrator.py" ]; then
    exec python3 "/usr/share/vde/apps/crossnarrator/crossnarrator.py" "$@"
fi
exec orca "$@"
