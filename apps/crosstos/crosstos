#!/usr/bin/env bash
SCRIPT_DIR="$(dirname "$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")")"
if [ -f "$SCRIPT_DIR/crosstos.py" ]; then
    exec python3 "$SCRIPT_DIR/crosstos.py" "$@"
elif [ -f "/usr/share/vde/apps/crosstos/crosstos.py" ]; then
    exec python3 "/usr/share/vde/apps/crosstos/crosstos.py" "$@"
fi
exec eog "$@" || exec feh "$@"
