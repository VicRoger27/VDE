{
  "layer": "top",
  "position": "bottom",
  "height": 48,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 4,

  "modules-left": [
    "custom/vde_pill"
  ],

  "modules-center": [
    "custom/start",
    "custom/terminal",
    "custom/files",
    "custom/settings",
    "custom/snip",
    "wlr/taskbar"
  ],

  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "clock"
  ],

  "custom/vde_pill": {
    "format": " :\\:V:/: VDE ",
    "tooltip": false
  },

  "custom/start": {
    "format": " ⊞ ",
    "tooltip-format": "Start Menu (Win Key)",
    "on-click": "/usr/local/bin/vde-launcher"
  },

  "custom/terminal": {
    "format": "  ",
    "tooltip-format": "Terminal (Crossminal)",
    "on-click": "/usr/local/bin/crossminal"
  },

  "custom/files": {
    "format": "  ",
    "tooltip-format": "File Explorer (Crossmanager)",
    "on-click": "/usr/local/bin/crossmanager"
  },

  "custom/settings": {
    "format": "  ",
    "tooltip-format": "Crossings Settings (Super+I)",
    "on-click": "/usr/local/bin/crossings"
  },

  "custom/snip": {
    "format": "  ",
    "tooltip-format": "Snipping Tool (Crossnip)",
    "on-click": "/usr/local/bin/crossnip"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "waybar"
    ]
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "clock": {
    "format": "{:%I:%M %p\n%m/%d/%Y}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "/usr/local/bin/crosslock"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇 Muted",
    "format-icons": {
      "default": ["🔈", "🔉", "🔊"]
    },
    "on-click": "sh -c 'pavucontrol || pactl set-sink-mute @DEFAULT_SINK@ toggle || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'"
  },

  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "󰖪 Offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  }
}
