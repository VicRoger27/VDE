#!/bin/sh
# VDE Taskbar Shell Runner
# Executable entrypoint for Waybar with VDE Dark Mica Acrylic theme

SCRIPT_DIR="$(dirname "$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")")"
cd "$SCRIPT_DIR" 2>/dev/null || true

# Determine configuration and style paths
CONFIG_FILE="$SCRIPT_DIR/waybar_config.jsonc"
STYLE_FILE="$SCRIPT_DIR/waybar_style.css"

if [ ! -f "$CONFIG_FILE" ]; then
    CONFIG_FILE="/usr/share/vde/astal-shell/waybar_config.jsonc"
fi
if [ ! -f "$STYLE_FILE" ]; then
    STYLE_FILE="/usr/share/vde/astal-shell/waybar_style.css"
fi

if command -v waybar >/dev/null 2>&1; then
    exec waybar -c "$CONFIG_FILE" -s "$STYLE_FILE" "$@"
elif command -v ags >/dev/null 2>&1; then
    exec ags run app.ts "$@"
else
    echo "[VDE Shell Error] 'waybar' not found in PATH." >&2
    exit 1
fi
